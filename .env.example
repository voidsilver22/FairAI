FAIRLENS_ENVIRONMENT=development
FAIRLENS_DEBUG=true
FAIRLENS_STORAGE_BACKEND=local
FAIRLENS_QUEUE_BACKEND=local
FAIRLENS_COMPUTE_BACKEND=local
FAIRLENS_LOCAL_STORAGE_ROOT=.fairlens-data
FAIRLENS_UPLOAD_URL_TTL_MINUTES=30
FAIRLENS_DOWNLOAD_URL_TTL_MINUTES=30
FAIRLENS_SIGNED_URL_SECRET=replace-me
FAIRLENS_EXECUTE_INLINE_JOBS=true
FAIRLENS_DEFAULT_FAIRNESS_WEIGHT=0.35
FAIRLENS_MAX_COUNTERFACTUAL_SAMPLES=128
FAIRLENS_HOSTED_API_KEY=
GCP_PROJECT=
FAIRLENS_UPLOADS_BUCKET=fairlens-uploads
FAIRLENS_RESULTS_BUCKET=fairlens-results
FAIRLENS_ARCHIVE_BUCKET=fairlens-archive
FAIRLENS_BQ_DATASET=fairlens_audit
FAIRLENS_VERTEX_LOCATION=us-central1
FAIRLENS_BIAS_ENGINE_IMAGE=
FAIRLENS_DLP_ENABLED=false

